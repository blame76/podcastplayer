#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

find provider/php tools tests -name '*.php' -print0 | xargs -0 -n1 php -l
node --check public/assets/provider-client.js
node --check public/assets/app.js
node --check public/sw.js
node --check tests/provider_client.test.js
node --check tests/player.test.js
php tests/rss_parser_test.php
php tests/provider_php_test.php
node tests/provider_client.test.js
node tests/player.test.js

echo "tests OK"
